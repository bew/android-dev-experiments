<?xml version="1.0" encoding="utf-8"?>
<!--
  WHAT:
  Declares the app to the Android OS — package identity, the MainActivity as
  the launcher entry point, the app-wide theme, and any required permissions.

  NEEDED: Yes — mandatory.
  Android won't install the app without it.

  MAINTAINANCE:
  Add <uses-permission> tags when you need system features (camera, internet, etc.).
  Register new Activity, Service, or BroadcastReceiver components here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyEnergyBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyEnergyBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
